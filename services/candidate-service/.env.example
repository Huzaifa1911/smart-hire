# Copy to .env and adjust. Service vars use the CANDIDATE_ prefix; database vars use CANDIDATE_DB_.

# --- Service ---
CANDIDATE_SERVICE_NAME=candidate-service
CANDIDATE_DEBUG=false
CANDIDATE_BASE_PATH=/candidate-service/v1

# --- HTTP ---
# JSON array (pydantic parses complex types as JSON)
CANDIDATE_CORS_ALLOW_ORIGINS=["*"]

# --- Logging ---
CANDIDATE_LOG_LEVEL=INFO
CANDIDATE_LOG_COLORS=true

# --- Database ---
# USER, PASSWORD and NAME are required — the service will not start without them.
# Local Postgres is published on 5433 (see docker-compose.yml).
CANDIDATE_DB_HOST=localhost
CANDIDATE_DB_PORT=5433
CANDIDATE_DB_USER=candidate
CANDIDATE_DB_PASSWORD=candidate
CANDIDATE_DB_NAME=candidate
CANDIDATE_DB_POOL_SIZE=10
CANDIDATE_DB_MAX_OVERFLOW=0
CANDIDATE_DB_POOL_RECYCLE=300
CANDIDATE_DB_POOL_PRE_PING=true
CANDIDATE_DB_ECHO=false
