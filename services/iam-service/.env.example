# Copy to .env and adjust. Service vars use the IAM_ prefix; database vars use IAM_DB_.

# --- Service ---
IAM_SERVICE_NAME=iam-service
IAM_DEBUG=false
IAM_BASE_PATH=/iam-service/v1

# --- HTTP ---
# JSON array (pydantic parses complex types as JSON)
IAM_CORS_ALLOW_ORIGINS=["*"]

# --- Logging ---
IAM_LOG_LEVEL=INFO
IAM_LOG_COLORS=true

# --- Database ---
# USER, PASSWORD and NAME are required — the service will not start without them.
# Local Postgres is published on 5432 (see docker-compose.yml).
IAM_DB_HOST=localhost
IAM_DB_PORT=5432
IAM_DB_USER=iam
IAM_DB_PASSWORD=iam
IAM_DB_NAME=iam
IAM_DB_POOL_SIZE=10
IAM_DB_MAX_OVERFLOW=0
IAM_DB_POOL_RECYCLE=300
IAM_DB_POOL_PRE_PING=true
IAM_DB_ECHO=false
